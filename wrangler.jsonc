{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kamaik-catalog",
  "compatibility_date": "2026-10-15",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "assets": {
    "directory": "./out"
  }
}
